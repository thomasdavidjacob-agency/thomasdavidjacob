# Copy to .env.local for local dev. Production values live in Vercel → Settings → Environment Variables.

# Resend (contact form + /api/lead)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where Success Kit demo requests and DealKit founding signups are emailed
LEAD_TO_EMAIL=thomasdavidjacob@gmail.com

# Verified Resend sender
LEAD_FROM_EMAIL="Thomas David Jacob <hello@thomasdavidjacob.com>"

# Spam stack (lib/spam-guard.ts) — used by /api/contact and /api/lead
# HMAC key for the signed time token. Falls back to RESEND_API_KEY if unset.
FORM_SIGNING_SECRET=long-random-string
# Cloudflare Turnstile. Server enforces only when the secret is set; widget shows only when the site key is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
